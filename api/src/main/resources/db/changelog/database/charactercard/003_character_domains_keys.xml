<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.7"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.7 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.7.xsd">

    <changeSet id="003_character_domains_keys" author="oscar">
        <addForeignKeyConstraint
            baseTableName="character_domains"
            baseColumnNames="character_card_id"
            referencedTableName="character_card"
            referencedColumnNames="id"
            constraintName="fk_character_domains_character_card" />
        <addForeignKeyConstraint
            baseTableName="character_domains"
            baseColumnNames="domains_id"
            referencedTableName="domains"
            referencedColumnNames="id"
            constraintName="fk_character_domains_domains" />
    </changeSet>
</databaseChangeLog>