<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.7"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.7 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.7.xsd">

    <changeSet id="key_archetype_character" author="oscar">
        <addForeignKeyConstraint
            baseTableName="character_archetypes"
            baseColumnNames="character_card_id"
            referencedTableName="character_card"
            referencedColumnNames="id"
            constraintName="fk_archetype_character_card_character_card" />
        <addForeignKeyConstraint
            baseTableName="character_archetypes"
            baseColumnNames="archetype_id"
            referencedTableName="archetype"
            referencedColumnNames="id"
            constraintName="fk_archetype_character_card_archetype" />
    </changeSet>
</databaseChangeLog>