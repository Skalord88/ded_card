<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.7"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.7 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.7.xsd">

    <changeSet id="key_class_pc_character_card" author="oscar">
        <addForeignKeyConstraint
            baseTableName="class_pc"
            baseColumnNames="character_card_id"
            referencedTableName="character_card"
            referencedColumnNames="id"
            constraintName="fk_class_pc_character_card_class_pc" />

        <addForeignKeyConstraint
            baseTableName="class_pc"
            baseColumnNames="class_character_id"
            referencedTableName="class_character"
            referencedColumnNames="id"
            constraintName="fk_class_pc_class_character_class_character" />
        </changeSet>
</databaseChangeLog>