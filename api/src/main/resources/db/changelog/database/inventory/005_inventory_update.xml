    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.7 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.7.xsd">
    <changeSet id="005_inventory_update" author="oscar">

        <update tableName="inventory">
            <!-- Puli -->
            <column name="armor_id" valueNumeric="1001" />
            <column
                name="shield_id" valueNumeric="1002" />
            <column
                name="weapon_id_one" valueNumeric="1003" />
