<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.7"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.7 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.7.xsd">

    <changeSet id="003_backpack_keys" author="oscar">

        <addForeignKeyConstraint
            baseTableName="backpack"
            baseColumnNames="inventory_id"
            constraintName="fk_backpack_inventory"
            referencedTableName="inventory"
            referencedColumnNames="id" />

        <addForeignKeyConstraint
            baseTableName="backpack"
            baseColumnNames="item_id"
            constraintName="fk_backpack_item"
            referencedTableName="item"
            referencedColumnNames="id" />

        <addForeignKeyConstraint
            baseTableName="quiver"
            baseColumnNames="inventory_id"
            constraintName="fk_quiver_inventory"
            referencedTableName="inventory"
            referencedColumnNames="id" />

        <addForeignKeyConstraint
            baseTableName="quiver"
            baseColumnNames="item_in_pack_id"
            constraintName="fk_quiver_item_in_pack"
            referencedTableName="item_in_pack"
            referencedColumnNames="id" />

    </changeSet>
</databaseChangeLog>