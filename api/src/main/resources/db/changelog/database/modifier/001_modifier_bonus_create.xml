<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.7"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.7 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.7.xsd">

    <changeSet id="001_modifier_bonus_create" author="oscar">
        <createTable tableName="modifier_bonus">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true" />
            </column>
            <column name="modifier" type="VARCHAR(20)">
                <constraints nullable="false" unique="true" />
            </column>

            <column name="bonus" type="INTEGER" />

            <column name="target" type="JSON">
                <constraints nullable="false" unique="true" />
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>