<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.7"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.7
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.7.xsd">

    <changeSet id="203" author="oscar">
        <createTable tableName="prerequisite">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="abilitys" type="jsonb">
                <constraints nullable="true"/>
            </column>
            <column name="caster" type="jsonb">
                <constraints nullable="true"/>
            </column>
            <column name="bab" type="INTEGER">
                <constraints nullable="true"/>
            </column>
            <!-- <column name="skill_study" type="jsonb">
                <constraints nullable="true"/>
            </column> -->
            <column name="armor_class" type="jsonb">
                <constraints nullable="true"/>
            </column>
            <column name="armor_type" type="jsonb">
                <constraints nullable="true"/>
            </column>
            <column name="weapon_type" type="jsonb">
                <constraints nullable="true"/>
            </column>
            <column name="class_pc" type="jsonb">
                <constraints nullable="true"/>
            </column>
            <column name="domain_id" type="int">
                <constraints nullable="true"/>
            </column>
            <column name="text" type="VARCHAR(225)">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <createTable tableName="prerequisite_feat">
            <column name="prerequisite_id" type="int" />
            <column name="feat_id" type="int" />
        </createTable>

        <createTable tableName="prerequisite_schools">
            <column name="prerequisite_id" type="int" />
            <column name="schools_id" type="int" />
        </createTable>

        <createTable tableName="prerequisite_item">
            <column name="prerequisite_id" type="int" />
            <column name="item_id" type="int" />
        </createTable>

