<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.7"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.7 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.7.xsd">

  <changeSet id="23" author="oscar">
    <createTable tableName="archetype">
      <column name="id" type="int" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="archetype_name" type="varchar(255)">
        <constraints nullable="true" />
      </column>
      <column name="modifiers_id" type="bigint">
        <constraints nullable="true" />
      </column>
      <column name="level_adjustment" type="TINYINT">
        <constraints nullable="true" />
      </column>
      <column name="avatar_url" type="varchar(255)">
        <constraints nullable="true" />
      </column>
    </createTable>

    <createTable tableName="special_abilities">
      <column name="id" type="int" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="special_type" type="int">
        <constraints nullable="true" />
      </column>
      <column name="name" type="varchar(255)">
        <constraints nullable="true" />
      </column>
      <column name="type" type="varchar(255)">
        <constraints nullable="true" />
      </column>
      <column name="description" type="varchar(500)">
        <constraints nullable="true" />
      </column>
      <column name="dc" type="Integer">
        <constraints nullable="true" />
      </column>
      <column name="dc_ability" type="json">
        <constraints nullable="true" />
      </column>
      <column name="value" type="Integer">
        <constraints nullable="true" />
      </column>
      <column name="value_text" type="varchar(255)">
        <constraints nullable="true" />
      </column>
      <column name="damage_dice" type="varchar(255)">
        <constraints nullable="true" />
      </column>
      <column name="damage_number_dice" type="Integer">
        <constraints nullable="true" />
      </column>
      <column name="prerequisite_hd" type="Integer">
        <constraints nullable="true" />
      </column>
      <column name="max_value" type="Integer">
        <constraints nullable="true" />
      </column>
      <column name="target" type="varchar(255)">
        <constraints nullable="true" />
      </column>
      <column name="area" type="varchar(255)">
        <constraints nullable="true" />
      </column>
    </createTable>

    <createTable tableName="archetype_special_abilities">
      <column name="archetype_id" type="int">
        <constraints nullable="true" />
      </column>
      <column name="special_abilities_id" type="int">
        <constraints nullable="true" />
      </column>
    </createTable>
  </changeSet>
</databaseChangeLog>