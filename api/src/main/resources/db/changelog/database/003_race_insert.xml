    <changeSet id="7" author="oscar">

        <!-- Dwarf -->

        <insert tableName="prerequisite">
            <column name="id" value="100001" />
            <column name="speed" value="{ &quot;foot&quot; : 20 }" />
            <column name="armor_class"
                value="{
                &quot;dodgeBonus&quot;: 4,
                &quot;target&quot;: [&quot;GIANT&quot;],
                &quot;special&quot; : &quot;+4 dodge bonus to Armor Class against monsters of the giant type. Any time a creature loses its Dexterity bonus (if any) to Armor Class, such as when it’s caught flat-footed, it loses its dodge bonus, too.&quot;
                }" />
            <column name="special_attacks"
                value="{
                &quot;vsBullRush&quot;: 4,
                &quot;special&quot; : &quot;Stability: A dwarf gains a +4 bonus on ability checks made to resist being bull rushed or tripped when standing on the ground (but not when climbing, flying, riding, or otherwise not standing firmly on the ground)&quot;
                }" />
            <column name="abilitys"
                value="{
                &quot;constitution&quot; : 2,
                &quot;charisma&quot; : -2
                }" />
            <column name="text" value="Dwarf races modifiers" />
        </insert>

        <insert tableName="prerequisite_skill_study">
