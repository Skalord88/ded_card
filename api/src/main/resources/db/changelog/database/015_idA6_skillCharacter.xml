<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.7"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.7 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.7.xsd">

    <changeSet id="106" author="oscar">
        <createTable tableName="skill_character">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true" />
            </column>
            <column name="skill_id" type="int">
                <constraints nullable="true" />
            </column>
            <column name="study_id" type="int">
                <constraints nullable="true" />
            </column>
            <column name="rank" type="decimal">
                <constraints nullable="true" />
            </column>
        </createTable>

        <insert tableName="skill_character">
            <column name="id" value="1" />
            <column name="skill_id" value="1" />
            <!-- <column name="study_id" value="17" /> -->
            <column name="rank" value="10.5" />
        </insert>

    </changeSet>
</databaseChangeLog>