<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.7"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.7 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.7.xsd">

  <changeSet id="003_region_keys" author="oscar">
    <addForeignKeyConstraint
      baseTableName="region_alignments"
      baseColumnNames="region_id"
      constraintName="fk_region_alignment_region"
      referencedTableName="region"
      referencedColumnNames="id" />
    <addForeignKeyConstraint
      baseTableName="region_alignments"
      baseColumnNames="alignment_id"
      constraintName="fk_region_alignment_alignment"
      referencedTableName="alignment"
      referencedColumnNames="id" />
  </changeSet>
</databaseChangeLog>