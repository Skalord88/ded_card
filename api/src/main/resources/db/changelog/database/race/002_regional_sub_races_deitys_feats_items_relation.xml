<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.7"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.7 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.7.xsd">

    <changeSet id="002_regional_sub_races_deitys_feats_items_relation" author="damian">

        <createTable tableName="regional_sub_races">
            <column name="racial_region_id" type="INT">
                <constraints nullable="false" />
            </column>
            <column name="sub_race_id" type="int">
                <constraints nullable="false" />
            </column>
        </createTable>

        <createTable tableName="regional_deitys">
