                <constraints nullable="false" />
            </column>
            <column name="deity_id" type="int">
                <constraints nullable="false" />
            </column>
        </createTable>

        <createTable tableName="regional_feats">
            <column name="racial_region_id" type="INT">
                <constraints nullable="false" />
            </column>
            <column name="feat_id" type="int">
                <constraints nullable="false" />
            </column>
        </createTable>

        <createTable tableName="regional_items_op_one">
            <column name="racial_region_id" type="INT">
                <constraints nullable="false" />
            </column>
            <column name="enchanted_items_id" type="int">
