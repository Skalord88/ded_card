<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.7"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.7 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.7.xsd">

  <changeSet id="001_race_type_create" author="oscar">
    <createTable tableName="race_type">
      <column name="id" type="int" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="class_character_id" type="int">
        <constraints nullable="true" />
      </column>
      <column name="level" type="int">
        <constraints nullable="true" />
      </column>
    </createTable>
  </changeSet>
</databaseChangeLog>