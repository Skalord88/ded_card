<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.7"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.7 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.7.xsd">

  <changeSet id="003_sub_race_region_keys" author="oscar">
    <addForeignKeyConstraint
      baseTableName="race_region"
      baseColumnNames="sub_race_id"
      constraintName="fk_sub_race_region_sub_race"
      referencedTableName="sub_race"
      referencedColumnNames="id" />
    <addForeignKeyConstraint
      baseTableName="race_region"
      baseColumnNames="region_id"
      constraintName="fk_sub_race_region_region"
      referencedTableName="region"
      referencedColumnNames="id" />
  </changeSet>
</databaseChangeLog>