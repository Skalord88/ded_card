<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.7"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.7 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.7.xsd">

  <changeSet id="003_sub_race_keys" author="oscar">
    <addForeignKeyConstraint
      baseTableName="sub_race"
      baseColumnNames="race_id"
      constraintName="fk_sub_race_race"
      referencedTableName="race"
      referencedColumnNames="id" />
    <addForeignKeyConstraint
      baseTableName="sub_race"
      baseColumnNames="size_id"
      constraintName="fk_sub_race_size"
      referencedTableName="size"
      referencedColumnNames="id" />
    <addForeignKeyConstraint
      baseTableName="sub_race"
      baseColumnNames="modifiers_id"
      constraintName="fk_sub_race_prerequisite"
      referencedTableName="prerequisite"
      referencedColumnNames="id" />
    <addForeignKeyConstraint
      baseTableName="sub_race"
      baseColumnNames="race_type_id"
      constraintName="fk_sub_race_race_type"
      referencedTableName="race_type"
      referencedColumnNames="id" />
  </changeSet>
</databaseChangeLog>