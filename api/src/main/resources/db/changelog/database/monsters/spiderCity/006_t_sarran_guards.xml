<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.7"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.7 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.7.xsd">

    <changeSet id="006_t_sarran_guards" author="oscar">
        <insert tableName="character_card">
            <column name="id" value="10001" />
            <column name="character_name" value="T'Saran Guard" />
            <column name="player_name" value="" />
            <column name="abilitys"
                value="{
                &quot;strength&quot;: 16,
                &quot;dexterity&quot;: 15,
                &quot;constitution&quot;: 12,
                &quot;intelligence&quot;: 10,
                &quot;wisdom&quot;: 12,
                &quot;charisma&quot;: 12
            }" />
            <column name="sub_race_id" value="103" />
            <column name="special_attacks" value="{}" />
            <column name="alignment_id" value="9" />
            <column name="experience" value="0" />
            <column name="treasure" value="0" />
        </insert>

        <insert tableName="class_pc">
            <column name="level" value="6" />
            <column name="first_class" value="true" />
            <column name="character_card_id" value="10001" />
            <column name="class_character_id" value="5" /> <!-- FIGHTER -->
        </insert>

        <insert tableName="attacks">
            <column name="id" value="10001" />
            <!-- T'Saran Guard -->
        </insert>

        <insert tableName="inventory">
            <column name="id" value="10001" />
            <column name="version" value="1" />
        </insert>

        <!-- T'Saran Guard -->
        <update tableName="attacks">
            <column name="attacks_id_onefirst" value="6204" />
            <!-- Sword, bastard +1 -->
            <column name="attacks_id_onesecond"
                value="4134" />
            <!-- Longbow, composite --> 
            <where>id = 10001</where>
        </update>

        <update tableName="inventory">
            <!-- T'Saran Guard -->
            <column name="armor_id" valueNumeric="6523" />
            <!-- Full plate +1 -->
            <column
                name="shield_id" valueNumeric="6117" />
            <!-- Shield, heavy +1 -->
            <column
                name="weapon_id_one" valueNumeric="6204" />
            <!-- Sword, bastard +1 -->
            <column name="weapon_id_two"
                valueNumeric="4134" />
            <!-- Longbow, composite --> 
        <where>id = 10001</where>
        </update>

        <update tableName="character_card">
            <column name="attacks_id" valueNumeric="10001" />
        <where>id = 10001</where>
        </update>

        <update tableName="character_card">
            <column name="inventory_id" valueNumeric="10001" />
        <where>id = 10001</where>
        </update>

    </changeSet>
</databaseChangeLog>