<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.7"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.7 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.7.xsd">

  <changeSet id="001_feat_create" author="oscar">
    <createTable tableName="feat">
      <column name="id" type="int" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="feat_name" type="varchar(255)">
        <constraints nullable="true" />
      </column>
      <column name="feat_type" type="jsonb">
        <constraints nullable="true" />
      </column>
      <column name="feat_text" type="varchar(10000)">
        <constraints nullable="true" />
      </column>
      <column name="benefit" type="varchar(10000)">
        <constraints nullable="true" />
      </column>
      <column name="normal" type="varchar(10000)">
        <constraints nullable="true" />
      </column>
      <column name="special" type="varchar(10000)">
        <constraints nullable="true" />
      </column>
      <column name="prerequisite" type="varchar(10000)">
        <constraints nullable="true" />
      </column>
      <column name="modifiers_id" type="bigint">
        <constraints nullable="true" />
      </column>
      <column name="prerequisite_list_id" type="bigint">
        <constraints nullable="true" />
      </column>
      <column name="to_select_id" type="bigint">
        <constraints nullable="true" />
      </column>
      <column name="selected_id" type="bigint">
        <constraints nullable="true" />
      </column>
    </createTable>
  </changeSet>
</databaseChangeLog>