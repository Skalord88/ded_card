<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.7"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.7 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.7.xsd">

    <changeSet id="001_feat_pc_create" author="oscar">
        <createTable tableName="feat_pc">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="character_card_id" type="int">
                <constraints nullable="true" />
            </column>
            <column name="feat_id" type="int">
                <constraints nullable="true" />
            </column>
            <column name="level" type="int">
                <constraints nullable="true" />
            </column>
            <column name="class_feat_id" type="int">
                <constraints nullable="true" />
            </column>
            <column name="selected_id" type="bigint">
                <constraints nullable="true" />
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>