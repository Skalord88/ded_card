<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.7"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.7 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.7.xsd">

    <changeSet id="keys_class_feats" author="oscar">
        <addForeignKeyConstraint
            baseTableName="class_character"
            baseColumnNames="class_character_id"
            constraintName="fk_class_character_class_feats"
            referencedTableName="class_feats"
            referencedColumnNames="id" />
        <addForeignKeyConstraint
            baseTableName="class_character"
            baseColumnNames="feats_id"
            constraintName="fk_class_character_feats"
            referencedTableName="feats"
            referencedColumnNames="id" />
        <addForeignKeyConstraint
            baseTableName="class_character"
            baseColumnNames="selected_id"
            constraintName="fk_class_character_selected"
            referencedTableName="prerequisite"
            referencedColumnNames="id" />
        <addForeignKeyConstraint
            baseTableName="class_character"
            baseColumnNames="selected_id"
            constraintName="fk_class_character_to_select"
            referencedTableName="prerequisite"
            referencedColumnNames="id" />

    </changeSet>
</databaseChangeLog>