<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.7"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.7 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.7.xsd">

    <changeSet id="keys_feats_pc" author="oscar">
        <addForeignKeyConstraint
            baseTableName="feats_pc"
            baseColumnNames="class_character_id"
            constraintName="fk_feats_pc_class_character"
            referencedTableName="class_character"
            referencedColumnNames="id" />
        <addForeignKeyConstraint
            baseTableName="feats_pc"
            baseColumnNames="feats_id"
            constraintName="fk_feats_pc_feats"
            referencedTableName="feats"
            referencedColumnNames="id" />
        <addForeignKeyConstraint
            baseTableName="feats_pc"
            baseColumnNames="class_feats_id"
            constraintName="fk_feats_pc_class_feats"
            referencedTableName="class_feats"
            referencedColumnNames="id" />
        <addForeignKeyConstraint
            baseTableName="feats_pc"
            baseColumnNames="selected_id"
            constraintName="fk_feats_pc_selected"
            referencedTableName="prerequisite"
            referencedColumnNames="id" />

    </changeSet>
</databaseChangeLog>