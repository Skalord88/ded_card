<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.7"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.7 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.7.xsd">

    <changeSet id="001_class_feat_create" author="oscar">
        <createTable tableName="class_feat">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true" />
            </column>
            <column name="level" type="int">
                <constraints nullable="true" />
            </column>
            <column name="class_character_id" type="int">
                <constraints nullable="true" />
            </column>
            <column name="feat_id" type="int">
                <constraints nullable="true" />
            </column>
            <column name="selected_id" type="bigint">
                <constraints nullable="true" />
            </column>
            <column name="to_select_id" type="bigint">
                <constraints nullable="true" />
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>