<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.7"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.7 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.7.xsd">

    <changeSet id="keys_feats" author="oscar">
        <addForeignKeyConstraint
            baseTableName="feats"
            baseColumnNames="modifiers_id"
            constraintName="fk_feats_modifiers"
            referencedTableName="prerequisite"
            referencedColumnNames="id" />
        <addForeignKeyConstraint
            baseTableName="feats"
            baseColumnNames="prerequisite_list_id"
            constraintName="fk_feats_prerequisite_list"
            referencedTableName="feats"
            referencedColumnNames="id" />
        <addForeignKeyConstraint
            baseTableName="feats"
            baseColumnNames="to_select_id"
            constraintName="fk_feats_to_select"
            referencedTableName="prerequisite"
            referencedColumnNames="id" />
        <addForeignKeyConstraint
            baseTableName="feats"
            baseColumnNames="selected_id"
            constraintName="fk_feats_selected"
            referencedTableName="prerequisite"
            referencedColumnNames="id" />

    </changeSet>
</databaseChangeLog>