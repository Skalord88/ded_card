<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.7"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.7 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.7.xsd">

  <changeSet id="201" author="oscar">
    <createTable tableName="feats">
      <column name="id" type="int" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="feat_name" type="varchar(255)">
        <constraints nullable="true" />
      </column>
      <column name="feat_type" type="json">
        <constraints nullable="true" />
      </column>
      <column name="benefit" type="varchar(10000)">
        <constraints nullable="true" />
      </column>
      <column name="normal" type="varchar(10000)">
        <constraints nullable="true" />
      </column>
      <column name="special" type="varchar(10000)">
        <constraints nullable="true" />
      </column>
      <column name="modifiers_id" type="int">
        <constraints nullable="true" />
      </column>
      <column name="prerequisite_list_id" type="int">
        <constraints nullable="true" />
      </column>
      <column name="to_select_id" type="int">
        <constraints nullable="true" />
      </column>
    </createTable>

    <createTable tableName="prerequisite">
      <column name="id" type="int" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="abilitys" type="jsonb">
        <constraints nullable="true" />
      </column>
      <column name="caster" type="jsonb">
        <constraints nullable="true" />
      </column>
      <column name="bab" type="INTEGER">
        <constraints nullable="true" />
      </column>
      <column name="attack_roll" type="jsonb">
        <constraints nullable="true" />
      </column>
      <column name="damage_bonus" type="jsonb">
        <constraints nullable="true" />
      </column>
      <column name="initiative" type="INTEGER">
        <constraints nullable="true" />
      </column>
      <column name="speed" type="jsonb">
        <constraints nullable="true" />
      </column>
      <column name="saving_throw" type="jsonb">
        <constraints nullable="true" />
      </column>
      <column name="special_attacks" type="jsonb">
        <constraints nullable="true" />
      </column>
      <column name="armor_class" type="jsonb">
        <constraints nullable="true" />
      </column>
      <column name="armor_type" type="jsonb">
        <constraints nullable="true" />
      </column>
      <column name="weapon_type" type="jsonb">
        <constraints nullable="true" />
      </column>
      <column name="class_pc" type="jsonb">
        <constraints nullable="true" />
      </column>
      <column name="domain_id" type="int">
        <constraints nullable="true" />
      </column>
      <column name="text" type="VARCHAR(225)">
        <constraints nullable="true" />
      </column>
    </createTable>

    <createTable tableName="prerequisite_feat">
      <column name="prerequisite_id" type="int" />
      <column name="feat_id" type="int" />
    </createTable>

    <createTable tableName="prerequisite_schools">
      <column name="prerequisite_id" type="int" />
      <column name="schools_id" type="int" />
    </createTable>

    <createTable tableName="prerequisite_item">
      <column name="prerequisite_id" type="int" />
      <column name="item_id" type="int" />
    </createTable>

    <createTable tableName="prerequisite_skill_study">
      <column name="prerequisite_id" type="int" />
      <column name="prerequisite_skill_id" type="int" />
    </createTable>

    <!-- prerequisite_skill -->
    <createTable tableName="prerequisite_skill">
      <column name="id" type="int" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="skill_id" type="int">
        <constraints nullable="true" />
      </column>
      <column name="study_id" type="int">
        <constraints nullable="true" />
      </column>
      <column name="rank" type="int">
        <constraints nullable="false" />
      </column>
      <column name="target" type="jsonb">
        <constraints nullable="true" />
      </column>
    </createTable>
    <!-- prerequisite_skill -->
  </changeSet>
</databaseChangeLog>